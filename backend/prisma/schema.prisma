datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────
// USER SYSTEM
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  profileImage String?  // Local or Cloudinary URL
  address      String?  @db.Text
  role         Role     @default(USER)
  authProvider String   @default("local")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  cartItems    CartItem[]
  wishlist     WishlistItem[]
  orders       Order[]
  reviews      Review[]

  artistId     String?  @unique
  artist       Artist?  @relation(fields: [artistId], references: [id])
}

enum Role {
  SUPER_ADMIN
  MANAGER
  ARTIST
  USER
}

// ─────────────────────────────────────────────
// ARTIST
// ─────────────────────────────────────────────

model Artist {
  id             String       @id @default(uuid())
  name           String
  username       String?      @unique
  bio            String       @db.Text
  website        String?
  location       String?
  specialization String       // Used as 'Title' / Profession
  experience     String?
  profileImage   String?      // Local or Cloudinary URL
  socialLinks    Json?        // { instagram, behance, twitter }
  isVerified     Boolean      @default(false)
  followersCount Int          @default(0)
  followingCount Int          @default(0)
  
  artworks       Artwork[]
  commissions    Commission[]
  highlights     Highlight[]
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User?
}

// ─────────────────────────────────────────────
// STORY HIGHLIGHTS
// ─────────────────────────────────────────────

model Highlight {
  id          String         @id @default(uuid())
  title       String
  coverImage  String?        // Cloudinary URL
  order       Int            @default(0)
  artistId    String
  artist      Artist         @relation(fields: [artistId], references: [id], onDelete: Cascade)
  items       HighlightItem[]
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model HighlightItem {
  id          String      @id @default(uuid())
  highlightId String
  artworkId   String
  
  highlight   Highlight   @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  // We do NOT establish a strict relation to Artwork to avoid circular dependency/complexity, 
  // we just store the artworkId and fetch it.
  
  createdAt   DateTime    @default(now())
}

// ─────────────────────────────────────────────
// ARTWORK + INVENTORY
// ─────────────────────────────────────────────

model Artwork {
  id            String        @id @default(uuid())
  title         String
  description   String        @db.Text
  artworkStory  String?       @db.Text  // Emotional creation story
  category      Category
  medium        String
  price         Float?
  status        ArtworkStatus @default(AVAILABLE)
  yearCreated   Int
  dimensions    String?
  image         String                 // Primary image URL
  images        Json?                  // Array of additional image URLs
  featured      Boolean       @default(false)
  tags          Json?                  // Array of tag strings

  // Inventory
  stock         Int           @default(1)
  isOriginal    Boolean       @default(true)

  artistId      String
  artist        Artist        @relation(fields: [artistId], references: [id])

  commission    Commission?

  exhibitions   ExhibitionArtwork[]
  sales         Sale[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  reviews       Review[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum Category {
  PORTRAIT
  PEN_ART
  PAINTING
  KRISHNA_ART
  EXPERIMENTAL
}

enum ArtworkStatus {
  AVAILABLE
  SOLD
  UNAVAILABLE
}

// ─────────────────────────────────────────────
// SHOPPING CART
// ─────────────────────────────────────────────

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  artworkId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([userId, artworkId])
}

// ─────────────────────────────────────────────
// WISHLIST
// ─────────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  artworkId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([userId, artworkId])
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

model Order {
  id              String      @id @default(uuid())
  userId          String
  status          OrderStatus @default(PENDING)
  total           Float
  shippingName    String
  shippingEmail   String
  shippingPhone   String?
  shippingAddress String      @db.Text
  shippingCity    String
  shippingPincode String
  notes           String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  paymentMethod   String      @default("COD")
  paymentStatus   String      @default("PENDING")

  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  artworkId String
  quantity  Int     @default(1)
  price     Float   // Price at time of purchase

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  artwork   Artwork @relation(fields: [artworkId], references: [id])
}

// ─────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────

model Review {
  id        String   @id @default(uuid())
  userId    String
  artworkId String
  rating    Int      // 1–5
  comment   String   @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([userId, artworkId])
}

// ─────────────────────────────────────────────
// EXHIBITIONS
// ─────────────────────────────────────────────

model Exhibition {
  id          String              @id @default(uuid())
  name        String
  theme       String
  description String              @db.Text
  startDate   DateTime
  endDate     DateTime
  location    String?
  bannerImage String?
  artworks    ExhibitionArtwork[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model ExhibitionArtwork {
  exhibitionId String
  artworkId    String
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  artwork      Artwork    @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@id([exhibitionId, artworkId])
}

// ─────────────────────────────────────────────
// COMMISSIONS (Custom art requests)
// ─────────────────────────────────────────────

model Commission {
  id              String           @id @default(uuid())
  clientName      String
  email           String
  phone           String
  artworkType     String
  budget          String?
  deadline        DateTime?
  message         String           @db.Text
  referenceImage  String?
  status          CommissionStatus @default(PENDING)
  adminNotes      String?          @db.Text
  
  shippingAddress String
  shippingCity    String
  shippingPincode String
  advanceAmount   Float            @default(100.0)
  paymentStatus   String           @default("PAID")
  
  finalPrice      Float?
  submissionDate  DateTime?
  
  artistId        String?
  artist          Artist?          @relation(fields: [artistId], references: [id])
  
  artworkId       String?          @unique
  artwork         Artwork?         @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  completedAt     DateTime?
}

enum CommissionStatus {
  PENDING
  APPROVED
  IN_PROGRESS
  COMPLETED
  REJECTED
  REFUNDED
}

// ─────────────────────────────────────────────
// LEGACY SALE RECORD
// ─────────────────────────────────────────────

model Sale {
  id            String   @id @default(uuid())
  artworkId     String
  customerName  String
  customerEmail String
  salePrice     Float
  saleDate      DateTime @default(now())
  notes         String?  @db.Text
  artwork       Artwork  @relation(fields: [artworkId], references: [id])
}
