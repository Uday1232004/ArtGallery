# ArtBro Sketches - Backend Environment Configurations Example Template

# Port configuration
PORT=5001

# Prisma MySQL database connection URL
DATABASE_URL="mysql://username:password@localhost:3306/art_gallery_db"

# JWT Auth Secret Key (Change this to a strong random hash in production)
JWT_SECRET="generate_a_very_secure_long_random_string_here"

# Google Cloud OAuth 2.0 Client Credentials
# Note: Remove all placeholder strings; place your real Google Client ID here
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"

# Cloudinary Integration (Optional: for cloud assets storage backup)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
