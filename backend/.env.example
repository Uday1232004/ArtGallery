# 🎨 ArtBro Sketches - Backend Environment Configuration Template
# Copy this file to '.env' and customize it for your local environment.

# 🔌 Server Configuration
# The port the Express.js backend server will run on
PORT=5001

# 💾 Database Configuration (MySQL DBMS)
# For local manual MySQL installation, change root and password accordingly:
# DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/art_gallery_db"
#
# Default Docker-based MySQL URL (Recommended, zero-manual-config):
DATABASE_URL="mysql://root:artbro_root_pass@localhost:3306/art_gallery_db"

# 🔑 JWT Authentication Settings
# Change this to a secure, long random string in production
JWT_SECRET="supersecret_jwt_key_art_gallery_local_dev"

# ☁️ Google Cloud OAuth 2.0 Client Credentials
# REQUIRED: Put your active Google Client ID here. Get this from Google Cloud Console.
# Example: "1085731033087-8dna9r3dhg4louvd8javfu3s6p6gahpo.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="1085731033087-8dna9r3dhg4louvd8javfu3s6p6gahpo.apps.googleusercontent.com"

# 🖼️ Cloudinary Asset Integration (Optional)
# If empty, the backend will automatically fall back to local disk storage.
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
