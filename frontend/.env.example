# 🔌 API Endpoint
# The base REST API gateway URL pointing to your backend
VITE_API_URL="http://localhost:5001/api"

# ☁️ Google Cloud OAuth 2.0 Client ID
# REQUIRED: Same Google Client ID as the backend.
# Obtain this from the Google Cloud Console (under APIs & Services > Credentials).
VITE_GOOGLE_CLIENT_ID="1085731033087-8dna9r3dhg4louvd8javfu3s6p6gahpo.apps.googleusercontent.com"
